{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
