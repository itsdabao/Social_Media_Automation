# Optional API overrides.
API_HOST=127.0.0.1
API_PORT=3001

# Local PostgreSQL. Replace both password placeholders with your local password.
# URL-encode the password in DATABASE_URL if it contains special characters.
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://postgres:change-me@127.0.0.1:25432/social_media"

# Local MinIO. Replace both password placeholders with your local password.
MINIO_ROOT_USER=local-admin
MINIO_ROOT_PASSWORD=replace-with-your-local-password