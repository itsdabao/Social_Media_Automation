{
  "name": "@social-media/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.0",
    "npm": "11.21.1"
  },
  "scripts": {
    "prebuild": "prisma generate --config prisma7.config.ts",
    "build": "tsc -p tsconfig.json",
    "test:password": "node --test src/modules/auth/infrastructure/security/password-hash.test.ts",
    "test:session": "node --test src/modules/auth/application/use-cases/password-session.service.test.ts",
    "preseed:local-user": "prisma generate --config prisma7.config.ts",
    "seed:local-user": "node --env-file-if-exists=../../.env database/seed-local-user.ts"
  },
  "exports": {
    "./auth": {
      "types": "./dist/src/modules/auth/auth.d.ts",
      "import": "./dist/src/modules/auth/auth.js"
    },
    "./database": {
      "types": "./dist/src/infrastructure/database/create-prisma-client.d.ts",
      "import": "./dist/src/infrastructure/database/create-prisma-client.js"
    },
    "./post-drafts": {
      "types": "./dist/src/modules/post-drafts/post-drafts.d.ts",
      "import": "./dist/src/modules/post-drafts/post-drafts.js"
    }
  },
  "devDependencies": {
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  }
}
