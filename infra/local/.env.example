# Public examples for this loopback-only local stack. Keep actual values in .env.
APP_POSTGRES_PASSWORD=local-app-change-me
TEMPORAL_POSTGRES_PASSWORD=local-temporal-change-me
MINIO_ROOT_USER=local-admin
MINIO_ROOT_PASSWORD=local-minio-change-me

# Separate from existing Postiz/Celesnity ports. Container ports stay standard.
APP_POSTGRES_PORT=25432
TEMPORAL_PORT=27233
TEMPORAL_UI_PORT=28080
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
TEMPORAL_NAMESPACE=social-media
